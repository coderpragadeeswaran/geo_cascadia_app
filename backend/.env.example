# Copy to backend/.env (gitignored). Never commit real values.

# Supabase Postgres — use the SESSION POOLER URI (IPv4), not the direct host (IPv6-only on free tier).
# PostGIS is in the `extensions` schema; the backend sets search_path=public,extensions itself.
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Supabase Storage (appeal photos)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=appeals

# Served to the browser by GET /config/public — must be the referrer-restricted BROWSER key only.
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAP_ID=

# Shared secret with the Colab worker (X-Worker-Token header). Any long random string.
WORKER_TOKEN=

# Allowed browser origins (comma-separated)
CORS_ORIGINS=http://localhost:5173
